# 复制本文件为 .env.development（本地开发）或 .env.production（生产构建）后按需填写

# ===== 简历保存服务（仓库根目录 server.mjs）=====
# 本地开发：先在仓库根目录跑 PORT=8080 node server.mjs，然后填：
# VITE_RESUME_API_URL=http://localhost:8080/api/resume
# Docker 单容器部署：留空即可，代码自动回退到同源 /api/resume
VITE_RESUME_API_URL=/api/resume

# 服务器端设置了 RESUME_TOKEN 时，这里填同样的值（保存与导出接口鉴权）
# VITE_RESUME_TOKEN=

# ===== PDF/PNG 导出服务 =====
# 外部导出服务器地址（兼容原作者的 Netlify 函数，已下线）
# 留空则使用容器内置导出服务 /api/pdf/export（Playwright 无头浏览器）
# VITE_EXPORT_URL=

# 生产构建时去除 console/debugger
VITE_DROP_CONSOLE=true

# ===== 作者原项目的统计/展示接口（可选，留空则对应功能静默失效）=====
# Upstash：导出总数、模板热度统计；Gitee：首页 star 列表
# VITE_UPSTASH_BASE_URL=
# VITE_UPSTASH_GET_TOKEN=
# VITE_UPSTASH_SET_TOKEN=
# VITE_GITEE_API_URL=
